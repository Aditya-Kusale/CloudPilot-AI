# Copy to .env for local development. Never commit .env or real credentials.
APP_NAME=CloudPilot AI
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_API_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./cloudpilot.db

# Configure strong secrets in a deployment secrets manager.
# APP_SECRET_KEY=

# Backend only; never expose to the frontend.
# OPENAI_API_KEY=

# Do not place cloud credentials here. Prefer role/workload identity
# and an appropriate secrets manager for provider authorization.
